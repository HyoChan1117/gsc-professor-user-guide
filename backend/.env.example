# .env.example → .env 로 복사한 뒤 값을 채우세요. (.env는 절대 커밋하지 마세요)

# 검색용 임베딩 — OpenAI (바꾸면 npm run seed 다시 실행)
OPENAI_API_KEY=sk-...
OPENAI_EMBED_MODEL=text-embedding-3-small

# 답변 생성 — Claude (비어 있으면 찾은 자료를 그대로 보여 주는 검색 모드로 동작)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (짧은 Q&A라 low 권장)
CLAUDE_EFFORT=low

PORT=8787

# 관리자 페이지(/admin) 비밀번호 — 비어 있으면 관리자 기능이 꺼집니다. 길고 추측하기 어렵게!
ADMIN_PASSWORD=
