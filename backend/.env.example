# .env.example → .env 로 복사한 뒤 값을 채우세요. (.env는 절대 커밋하지 마세요)

# .env 가 없어도 서버는 동작합니다 (검색은 키워드 검색이라 API 키가 필요 없음).

# (선택) AI 답변 · AI 퀴즈 · 제보 AI 정리 — Claude. 비워 두면 찾은 자료를 그대로 보여 주는 검색 모드 + 기본 퀴즈
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (짧은 Q&A라 low 권장)
CLAUDE_EFFORT=low

PORT=8787

# 관리자 페이지(/admin) 비밀번호 — 비어 있으면 관리자 기능이 꺼집니다. 길고 추측하기 어렵게!
ADMIN_PASSWORD=
